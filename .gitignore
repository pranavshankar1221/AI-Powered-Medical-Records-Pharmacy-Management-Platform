# ==========================================
# MEDIQR MLOPS Project - Root Gitignore
# ==========================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.cache/
.pytest_cache/
.ipynb_checkpoints/

# --- Virtual Environments ---
venv/
.venv/
env/
backend/venv/
backend/.venv/

# --- Environment & Configuration Secrets ---
.env
.env.local
.env.*.local
*.env
backend/.env
frontend/.env

# --- Node / Frontend ---
node_modules/
frontend/node_modules/
dist/
frontend/dist/
frontend/dist-ssr/
.eslintcache

# --- Backend Run-time Data & DBs ---
*.db
*.sqlite
*.sqlite3
data/
backend/data/
**/data/mlruns/
**/data/metrics/
**/data/raw/

# --- MLflow & DVC Run Artifacts ---
mlruns/
backend/mlruns/
.dvc/cache/
.dvc/tmp/

# --- Logs ---
*.log
logs/
backend/logs/
frontend/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- IDEs & Editors ---
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.suo
*.sln

# --- OS Specific ---
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
desktop.ini
